prefix=@CMAKE_INSTALL_PREFIX@
exec_prefix=${prefix}
libdir=${prefix}/@CMAKE_INSTALL_LIBDIR@
includedir=${prefix}/@CMAKE_INSTALL_INCLUDEDIR@

Name: @PROJECT_NAME@
Description: SIMD-accelerated columnar storage library for analytical workloads
Version: @PROJECT_VERSION@
Requires: liblz4, libzstd
Libs: -L${libdir} -lcolumnarstore
Cflags: -I${includedir}
